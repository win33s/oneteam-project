{
  "name": "culture-planner-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "조직문화활동 기획자를 위한 에이전트 데모 (Mock ERP/캘린더/메일 포함)",
  "scripts": {
    "dev": "concurrently -n server,client -c green,magenta \"node --watch-path=server server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "vite build && node server/index.js",
    "server": "node server/index.js",
    "reset": "node server/reset.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@upstash/redis": "^1.39.0",
    "cheerio": "^1.0.0",
    "express": "^4.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "vite": "^5.4.0"
  }
}
